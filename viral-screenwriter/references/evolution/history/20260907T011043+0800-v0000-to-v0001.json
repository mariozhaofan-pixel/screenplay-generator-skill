      {
        "rule_id": "RULE-DYN-002",
        "title": "接受者退步，让递物者主动走到新位置",
        "status": "candidate",
        "active": false,
        "scope": "剧情短片的可见道具交接与人物调度；仅视觉机制，不包含台词、音乐、拟音或声桥规则。",
        "mechanism": {
          "observed": "和尚拾钵伸手，短妖仍不接并后退；插入脚步近景确认和尚跟上，随后以三人全景展示其已站到岩壁前，最后才接钵。",
          "executable_judgment": "先给出一次未完成的递物，再让接受者移动、递物者跟随；用脚步镜与关系全景确认空间改变，最后完成交接。",
          "audience_information_change": "先延迟交接，让观众看到跟随与位置改变；正式接物随后确认先前移动产生了结果。"
        },
        "when_to_use": [
          "递物者有继续完成交接的动机，接受者的位置会影响交接条件。",
          "移动前后的空间差异有叙事意义，并能通过脚步或关系全景读清。",
          "交接可自然推迟到位移完成之后。"
        ],
        "when_not_to_use": [
          "后退只是构图调整，未改变处境、关系或动作结果。",
          "切镜省略关键位移，使人物像瞬移到新位置。",
          "递物者没有跟随动机，或交接早已完成却仍以递物解释移动。"
        ],
