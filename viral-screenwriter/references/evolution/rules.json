  "rules": [
    {
      "rule_id": "RULE-DYN-001",
      "title": "两件同类道具在相似请求中被不同处置，形成赠与对照",
      "status": "candidate",
      "active": false,
      "scope": "剧情短片的可见道具交接与人物调度；仅视觉机制，不包含台词、音乐、拟音或声桥规则。",
      "mechanism": {
        "observed": "前段用水碗近景和双方未松开的手，把给水与给容器分开；后段用另一只木钵的拾起、放下、再拾起与正式交接，把是否接受礼物同赠与者是否安全连在一起。",
        "executable_judgment": "两段相似请求采用同类但不同的道具，并用手部动作和交接是否完成表现不同的关系条件。",
        "audience_information_change": "观众先看到索取受阻，再在另一段看到交付条件被满足；相似物件使两次关系选择可比较。"
      },
      "when_to_use": [
        "同一故事有两段可比较的请求，人物处境或交付条件存在差异。",
        "观众能区分两件道具，并能看清谁持有、谁伸手、是否松手。",
        "交接是否完成会改变人物关系或后续行动。"
      ],
      "when_not_to_use": [
        "两次物件露出只有外观相似，没有不同的交付结果或关系变化。",
        "镜头无法分清两件道具，可能误读为同一物体跨场流转。",
        "价值判断只靠台词宣告，手部和持有人状态没有可见变化。"
      ],
